package garden_forward;

import com.ftn.sbnz.model.Crop;
import com.ftn.sbnz.model.Action;
import com.ftn.sbnz.model.ActionName;
import com.ftn.sbnz.model.Problem;
import com.ftn.sbnz.model.ProblemName;
import com.ftn.sbnz.model.SolutionName;
import com.ftn.sbnz.model.CultureName;
import com.ftn.sbnz.model.CultureStatus;
import com.ftn.sbnz.model.Recommendation;
import java.time.Month;

// ===================== STAGE PROGRESSION =====================

rule "Onion: weeding done -> step 2"
    when
        $c: Crop(cultureName == CultureName.ONION, level == 1, isActive())
        Action(name == ActionName.WEED_REMOVAL, done != null, done.month == Month.MAY) from $c.actions
    then
        modify($c) { setLevel(2) }
end

rule "Onion: fertilizing done -> step 3 (final)"
    when
        $c: Crop(cultureName == CultureName.ONION, level == 2, isActive())
        Action(name == ActionName.FERTILIZATION, done != null, done.month == Month.JUNE) from $c.actions
    then
        modify($c) { setLevel(3) }
end

// ===================== MISSED DEADLINE -> INF =====================

rule "Onion: missed weeding deadline -> INF"
    when
        $c: Crop(cultureName == CultureName.ONION, level == 1, isActive())
        eval( currentDate.getMonth().compareTo(Month.JUNE) >= 0 )
        not( Action(name == ActionName.WEED_REMOVAL, done != null, done.month == Month.MAY) from $c.actions )
    then
        modify($c) { setStatus(CultureStatus.INF) }
end

rule "Onion: missed fertilizing deadline -> INF"
    when
        $c: Crop(cultureName == CultureName.ONION, level == 2, isActive())
        eval( currentDate.getMonth().compareTo(Month.JULY) >= 0 )
        not( Action(name == ActionName.FERTILIZATION, done != null, done.month == Month.JUNE) from $c.actions )
    then
        modify($c) { setStatus(CultureStatus.INF) }
end

// ===================== ACTION DUE REMINDERS =====================

rule "Onion: weeding due reminder"
    when
        $c: Crop(cultureName == CultureName.ONION, level == 1, isActive())
        eval( currentDate.getMonth() == Month.MAY )
    then
        insert(new Recommendation(Recommendation.Type.ACTION_DUE, "Potrebno je ukloniti korov do kraja maja.", ActionName.WEED_REMOVAL));
end

rule "Onion: fertilizing due reminder"
    when
        $c: Crop(cultureName == CultureName.ONION, level == 2, isActive())
        eval( currentDate.getMonth() == Month.JUNE )
    then
        insert(new Recommendation(Recommendation.Type.ACTION_DUE, "Potrebno je izvršiti đubrenje do kraja juna.", ActionName.FERTILIZATION));
end

// ===================== PROBLEM -> SOLUTION RECOMMENDATIONS =====================

rule "Onion: downy mildew reported"
    when
        Crop(cultureName == CultureName.ONION, isActive(), $problems: problems)
        $p: Problem(name == ProblemName.DOWNY_MILDEW, addressed == null) from $problems
    then
        modify($p) { setProvidedSolution(SolutionName.APPLY_FUNGICIDE) }
        insert(new Recommendation(Recommendation.Type.PROBLEM_SOLUTION, "Prijavljena je plamenjača na luku - preporučena je primena zaštitnih sredstava protiv gljivica.", SolutionName.APPLY_FUNGICIDE));
end

rule "Onion: onion fly reported"
    when
        Crop(cultureName == CultureName.ONION, isActive(), $problems: problems)
        $p: Problem(name == ProblemName.ONION_FLY, addressed == null) from $problems
    then
        modify($p) { setProvidedSolution(SolutionName.APPLY_INSECTICIDE) }
        insert(new Recommendation(Recommendation.Type.PROBLEM_SOLUTION, "Prijavljeno je prisustvo lukove muve - preporučena je primena insekticida.", SolutionName.APPLY_INSECTICIDE));
end

// ===================== HARVEST RECOMMENDATION =====================

rule "Onion: harvest ready"
    when
        $c: Crop(cultureName == CultureName.ONION, isActive())
        eval( currentDate.getMonth() == Month.JULY )
    then
        insert(new Recommendation(Recommendation.Type.HARVEST_READY, "Vreme je za prikupljanje ploda luka."));
end