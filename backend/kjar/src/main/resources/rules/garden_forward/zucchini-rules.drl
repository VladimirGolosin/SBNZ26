package garden_forward;

import com.ftn.sbnz.model.Crop;
import com.ftn.sbnz.model.Action;
import com.ftn.sbnz.model.ActionName;
import com.ftn.sbnz.model.Problem;
import com.ftn.sbnz.model.ProblemName;
import com.ftn.sbnz.model.SolutionName;
import com.ftn.sbnz.model.CultureName;
import com.ftn.sbnz.model.CultureStatus;
import com.ftn.sbnz.model.Recommendation;
import java.time.Month;

rule "Zuccini: weeding done -> step 2"
    when
        $c: Crop(cultureName == CultureName.ZUCCINI, level == 1, isActive())
        Action(name == ActionName.WEED_REMOVAL, done != null, done.month == Month.MAY) from $c.actions
    then
        modify($c) { setLevel(2) }
end

rule "Zuccini: fertilizing done -> step 3 (final)"
    when
        $c: Crop(cultureName == CultureName.ZUCCINI, level == 2, isActive())
        Action(name == ActionName.FERTILIZATION, done != null, done.month == Month.JUNE) from $c.actions
    then
        modify($c) { setLevel(3) }
end

rule "Zuccini: missed weeding deadline -> INF"
    when
        $c: Crop(cultureName == CultureName.ZUCCINI, level == 1, isActive(), status != CultureStatus.INF)
        eval( currentDate.getMonth().compareTo(Month.JUNE) >= 0 )
        not( Action(name == ActionName.WEED_REMOVAL, done != null, done.month == Month.MAY) from $c.actions )
    then
        modify($c) { setStatus(CultureStatus.INF) }
end

rule "Zuccini: missed fertilizing deadline -> INF"
    when
        $c: Crop(cultureName == CultureName.ZUCCINI, level == 2, isActive(), status != CultureStatus.INF)
        eval( currentDate.getMonth().compareTo(Month.JULY) >= 0 )
        not( Action(name == ActionName.FERTILIZATION, done != null, done.month == Month.JUNE) from $c.actions )
    then
        modify($c) { setStatus(CultureStatus.INF) }
end

rule "Zuccini: weeding due reminder"
    when
        $c: Crop(cultureName == CultureName.ZUCCINI, level == 1, isActive())
        eval( currentDate.getMonth() == Month.MAY )
    then
        insert(new Recommendation(Recommendation.Type.ACTION_DUE, "Weeding must be done by the end of May.", ActionName.WEED_REMOVAL));
end

rule "Zuccini: fertilizing due reminder"
    when
        $c: Crop(cultureName == CultureName.ZUCCINI, level == 2, isActive())
        eval( currentDate.getMonth() == Month.JUNE )
    then
        insert(new Recommendation(Recommendation.Type.ACTION_DUE, "Fertilizing must be done by the end of June.", ActionName.FERTILIZATION));
end

rule "Zuccini: powdery mildew reported"
    when
        Crop(cultureName == CultureName.ZUCCINI, isActive(), $problems: problems)
        $p: Problem(name == ProblemName.POWDERY_MILDEW, addressed == null) from $problems
    then
        modify($p) { setProvidedSolution(SolutionName.APPLY_FUNGICIDE) }
        insert(new Recommendation(Recommendation.Type.PROBLEM_SOLUTION, "Powdery mildew reported - applying a fungicide is recommended.", SolutionName.APPLY_FUNGICIDE, ProblemName.POWDERY_MILDEW));
end

rule "Zuccini: aphids reported"
    when
        Crop(cultureName == CultureName.ZUCCINI, isActive(), $problems: problems)
        $p: Problem(name == ProblemName.APHIDS, addressed == null) from $problems
    then
        modify($p) { setProvidedSolution(SolutionName.APPLY_INSECTICIDE) }
        insert(new Recommendation(Recommendation.Type.PROBLEM_SOLUTION, "Aphids reported - applying an insecticide is recommended.", SolutionName.APPLY_INSECTICIDE, ProblemName.APHIDS));
end

rule "Zuccini: harvest ready"
    when
        $c: Crop(cultureName == CultureName.ZUCCINI, isActive())
        eval( currentDate.getMonth().compareTo(Month.JULY) >= 0 )
    then
        insert(new Recommendation(Recommendation.Type.HARVEST_READY, "It's time to harvest the zucchini."));
end