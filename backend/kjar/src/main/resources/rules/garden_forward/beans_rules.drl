package garden_forward;

import com.ftn.sbnz.model.Crop;
import com.ftn.sbnz.model.Action;
import com.ftn.sbnz.model.ActionName;
import com.ftn.sbnz.model.Problem;
import com.ftn.sbnz.model.ProblemName;
import com.ftn.sbnz.model.SolutionName;
import com.ftn.sbnz.model.CultureName;
import com.ftn.sbnz.model.CultureStatus;
import com.ftn.sbnz.model.Recommendation;
import java.time.Month;

// ===================== STAGE PROGRESSION =====================

rule "Beans: weeding done -> step 2"
    when
        $c: Crop(cultureName == CultureName.BEANS, level == 1, isActive())
        Action(name == ActionName.WEED_REMOVAL, done != null, done.month == Month.MAY) from $c.actions
    then
        modify($c) { setLevel(2) }
end

rule "Beans: fertilizing done -> step 3 (final)"
    when
        $c: Crop(cultureName == CultureName.BEANS, level == 2, isActive())
        Action(name == ActionName.FERTILIZATION, done != null, done.month == Month.JUNE) from $c.actions
    then
        modify($c) { setLevel(3) }
end

// ===================== MISSED DEADLINE -> INF =====================

rule "Beans: missed weeding deadline -> INF"
    when
        $c: Crop(cultureName == CultureName.BEANS, level == 1, isActive(), status != CultureStatus.INF)
        eval( currentDate.getMonth().compareTo(Month.JUNE) >= 0 )
        not( Action(name == ActionName.WEED_REMOVAL, done != null, done.month == Month.MAY) from $c.actions )
    then
        modify($c) { setStatus(CultureStatus.INF) }
end

rule "Beans: missed fertilizing deadline -> INF"
    when
        $c: Crop(cultureName == CultureName.BEANS, level == 2, isActive(), status != CultureStatus.INF)
        eval( currentDate.getMonth().compareTo(Month.JULY) >= 0 )
        not( Action(name == ActionName.FERTILIZATION, done != null, done.month == Month.JUNE) from $c.actions )
    then
        modify($c) { setStatus(CultureStatus.INF) }
end

// ===================== ACTION DUE REMINDERS =====================

rule "Beans: weeding due reminder"
    when
        $c: Crop(cultureName == CultureName.BEANS, level == 1, isActive())
        eval( currentDate.getMonth() == Month.MAY )
    then
        insert(new Recommendation(Recommendation.Type.ACTION_DUE, "Potrebno je ukloniti korov do kraja maja.", ActionName.WEED_REMOVAL));
end

rule "Beans: fertilizing due reminder"
    when
        $c: Crop(cultureName == CultureName.BEANS, level == 2, isActive())
        eval( currentDate.getMonth() == Month.JUNE )
    then
        insert(new Recommendation(Recommendation.Type.ACTION_DUE, "Potrebno je izvršiti đubrenje do kraja juna.", ActionName.FERTILIZATION));
end

// ===================== PROBLEM -> SOLUTION RECOMMENDATIONS =====================

rule "Beans: leaf spot reported"
    when
        Crop(cultureName == CultureName.BEANS, isActive(), $problems: problems)
        $p: Problem(name == ProblemName.BEAN_LEAF_SPOT, addressed == null) from $problems
    then
        modify($p) { setProvidedSolution(SolutionName.APPLY_FUNGICIDE) }
        insert(new Recommendation(Recommendation.Type.PROBLEM_SOLUTION, "Prijavljena je pegavost lista pasulja - preporučena je primena fungicida i uklanjanje zaraženih listova.", SolutionName.APPLY_FUNGICIDE));
end

rule "Beans: aphids reported"
    when
        Crop(cultureName == CultureName.BEANS, isActive(), $problems: problems)
        $p: Problem(name == ProblemName.APHIDS, addressed == null) from $problems
    then
        modify($p) { setProvidedSolution(SolutionName.APPLY_INSECTICIDE) }
        insert(new Recommendation(Recommendation.Type.PROBLEM_SOLUTION, "Prijavljeno je prisustvo lisnih vaši - preporučena je primena insekticida.", SolutionName.APPLY_INSECTICIDE));
end

// ===================== HARVEST RECOMMENDATION =====================

rule "Beans: harvest ready"
    when
        $c: Crop(cultureName == CultureName.BEANS, isActive())
        eval( currentDate.getMonth() == Month.JUNE )
    then
        insert(new Recommendation(Recommendation.Type.HARVEST_READY, "Vreme je za prikupljanje ploda pasulja."));
end